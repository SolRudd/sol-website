---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Home">
  <div class="w-full">
    <!-- Hero Section -->
    <section class="text-center">
      <div class="max-w-3xl mx-auto px-6 py-32">
        <h1 class="text-5xl md:text-7xl font-bold tracking-tight leading-tight">
          Operator & Technical Founder.
        </h1>
        <p class="mt-4 text-2xl text-zinc-400">
          Bridging performance, compliance, and commercial growth.
        </p>
        <div class="mt-8">
          <a href="#ventures" class="inline-flex h-12 items-center justify-center rounded-md bg-white px-8 text-sm font-semibold text-zinc-950 hover:bg-zinc-200 transition-colors">
            Explore my work
          </a>
        </div>
      </div>
    </section>

    <!-- Ventures/Products/Proof Section -->
    <section id="ventures" class="section-neutral">
      <div class="max-w-5xl mx-auto w-full px-6">
        <div class="text-center max-w-2xl mx-auto">
          <h2 class="text-4xl font-bold tracking-tight">Ventures & Products</h2>
          <p class="mt-4 text-zinc-400">A selection of projects I've built and scaled.</p>
        </div>
        <div class="mt-16 grid md:grid-cols-3 gap-12">
          <div class="p-8 bg-zinc-900/50 rounded-lg border border-zinc-800 transition-all duration-300 ease-in-out hover:border-zinc-700 hover:scale-105">
            <h3 class="text-xl font-semibold">BuzzBoost</h3>
            <p class="mt-2 text-zinc-400">Web Development & Digital Marketing Agency focused on ROI & conversion.</p>
          </div>
          <div class="p-8 bg-zinc-900/50 rounded-lg border border-zinc-800 transition-all duration-300 ease-in-out hover:border-zinc-700 hover:scale-105">
            <h3 class="text-xl font-semibold">GreenTracer</h3>
            <p class="mt-2 text-zinc-400">Green Website Intelligence Platform for carbon & speed scanning.</p>
          </div>
          <div class="p-8 bg-zinc-900/50 rounded-lg border border-zinc-800 transition-all duration-300 ease-in-out hover:border-zinc-700 hover:scale-105">
            <h3 class="text-xl font-semibold">LoveCookies</h3>
            <p class="mt-2 text-zinc-400">Smart Cookie Consent Made Simple (GDPR/CCPA/Consent Mode v2).</p>
          </div>
        </div>
      </div>
    </section>

    <!-- What I Do Section -->
    <section id="what-i-do" class="py-24">
      <div class="max-w-5xl mx-auto w-full px-6 grid md:grid-cols-2 gap-16 items-center">
        <div>
          <h2 class="text-4xl font-bold tracking-tight">What I Do</h2>
          <p class="mt-4 text-zinc-400">I partner with founders and executives to turn ambitious ideas into high-performing, compliant, and commercially successful digital products.</p>
        </div>
        <div class="space-y-6">
          <div class="p-6 bg-zinc-900/50 rounded-lg border border-zinc-800">
            <h4 class="font-semibold text-lg">Web Strategy</h4>
            <p class="text-zinc-400 text-base mt-1">Defining technical roadmaps that align with business goals.</p>
          </div>
          <div class="p-6 bg-zinc-900/50 rounded-lg border border-zinc-800">
            <h4 class="font-semibold text-lg">Technical Execution</h4>
            <p class="text-zinc-400 text-base mt-1">Building scalable, secure, and maintainable web applications.</p>
          </div>
          <div class="p-6 bg-zinc-900/50 rounded-lg border border-zinc-800">
            <h4 class="font-semibold text-lg">Performance Optimization</h4>
            <p class="text-zinc-400 text-base mt-1">Ensuring fast, efficient, and reliable user experiences.</p>
          </div>
        </div>
      </div>
    </section>
    
    <!-- Why work with me Section -->
    <section class="section-neutral py-24">
      <div class="max-w-3xl mx-auto px-6 text-center">
        <h2 class="text-4xl font-bold tracking-tight">Pragmatic, Direct, & Credible</h2>
        <p class="mt-4 text-zinc-400">No overhyping, no generic jargon. I focus on what works, delivering practical solutions that drive tangible results. My approach is rooted in deep technical expertise and a sharp commercial focus, ensuring that we not only build things right, but build the right things.</p>
      </div>
    </section>

    <!-- Insights/Thinking Section -->
    <section id="insights" class="py-24">
      <div class="max-w-5xl mx-auto px-6">
        <div class="text-center max-w-2xl mx-auto">
          <h2 class="text-4xl font-bold tracking-tight">Insights & Thinking</h2>
          <p class="mt-4 text-zinc-400">Pragmatic thoughts on AI, product building, and web performance.</p>
          <p class="mt-4 text-zinc-500 text-base">(Coming soon)</p>
        </div>
      </div>
    </section>

    <!-- Contact / CTA close Section -->
    <section id="contact" class="text-center py-32">
      <div class="max-w-2xl mx-auto px-6">
        <h2 class="text-4xl font-bold tracking-tight">Let's build together.</h2>
        <p class="mt-4 text-zinc-400">Have a project in mind or need a technical partner you can trust? Get in touch.</p>
        <div class="mt-8">
          <a href="mailto:sol@solrudd.com" class="inline-flex h-12 items-center justify-center rounded-md bg-white px-8 text-sm font-semibold text-zinc-950 hover:bg-zinc-200 transition-colors">
            sol@solrudd.com
          </a>
        </div>
      </div>
    </section>
  </div>
</Layout>
